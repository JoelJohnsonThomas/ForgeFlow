# ============================================================
# ForgeFlow — Environment Variables
# Copy to .env and fill in your values
# ============================================================

# --- LLM Provider ---
# One of: openai | ollama | anthropic
LLM_PROVIDER=openai

# --- OpenAI (when LLM_PROVIDER=openai) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL_STRONG=gpt-4o

# --- Ollama (when LLM_PROVIDER=ollama) ---
# Install: pip install 'forgeflow[ollama]' and run an Ollama daemon
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_MODEL_STRONG=llama3.1:8b

# --- Anthropic (when LLM_PROVIDER=anthropic) ---
# Install: pip install 'forgeflow[anthropic]'
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_MODEL_STRONG=claude-sonnet-4-5

# --- PostgreSQL (asyncpg DSN) ---
# Format: postgresql+asyncpg://user:password@host:port/dbname
POSTGRES_URL=postgresql+asyncpg://forgeflow:forgeflow@localhost:5432/forgeflow

# --- PostgreSQL (psycopg3 DSN for LangGraph checkpointer) ---
POSTGRES_SYNC_URL=postgresql://forgeflow:forgeflow@localhost:5432/forgeflow

# --- LangSmith (optional, but strongly recommended) ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=forgeflow

# --- MCP Server ---
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8001

# --- FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-me-in-production-use-secrets-manager

# --- Resilience ---
MAX_RETRIES=3
CIRCUIT_BREAKER_THRESHOLD=5
BUDGET_LIMIT_USD=5.0

# --- Web Search (Tavily) ---
TAVILY_API_KEY=tvly-...

# --- Tracing provider (high-level switch) ---
# One of: langsmith | phoenix | langfuse | none
# Picking phoenix or langfuse enables OTel automatically with the right endpoint.
TRACING_PROVIDER=langsmith

# --- Langfuse (when TRACING_PROVIDER=langfuse) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- OpenTelemetry (auto-configured by TRACING_PROVIDER; override below if needed) ---
# Install: pip install 'forgeflow[otel]'
OTEL_ENABLED=false
OTEL_SERVICE_NAME=forgeflow-api
OTEL_ENVIRONMENT=development
OTEL_EXPORTER_ENDPOINT=http://localhost:4318/v1/traces
# Comma-separated 'k=v' headers (used for vendor auth, e.g. Honeycomb / Datadog)
OTEL_EXPORTER_HEADERS=

# --- Slack (optional — for HITL approval notifications) ---
# Bot token: xoxb-...  Required scopes: chat:write, chat:write.public
SLACK_BOT_TOKEN=
SLACK_DEFAULT_CHANNEL=#forgeflow
# Externally-reachable URL of this API — used in Slack approve/reject buttons
API_PUBLIC_URL=http://localhost:8000

# --- Streamlit Dashboard ---
API_URL=http://localhost:8000

# --- Docker (used by docker-compose.yml) ---
POSTGRES_PASSWORD=forgeflow
