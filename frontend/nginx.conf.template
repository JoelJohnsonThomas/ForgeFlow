server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # SPA fallback — all unknown paths return index.html so the client router handles them.
  location / {
    try_files $uri $uri/ /index.html;
  }

  # Long-cache the hashed assets Vite emits under /assets/.
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  # Reverse-proxy API calls to the FastAPI service inside the compose network.
  # Inject the service token so the SPA inherits "admin" until real login lands.
  location /api/ {
    proxy_pass http://api:8000/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Authorization "Bearer ${API_SECRET_KEY}";
    # SSE / chunked streaming — disable buffering so /workflows/{id}/stream works.
    proxy_buffering off;
    proxy_read_timeout 1h;
  }
}
